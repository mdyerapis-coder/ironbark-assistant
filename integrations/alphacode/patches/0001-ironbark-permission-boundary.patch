diff --git i/src/alphacode_app_core/tool/ironbark_permission_tests.rs w/src/alphacode_app_core/tool/ironbark_permission_tests.rs
new file mode 100644
index 0000000..bc73d40
--- /dev/null
+++ w/src/alphacode_app_core/tool/ironbark_permission_tests.rs
@@ -0,0 +1,105 @@
+use super::*;
+use crate::alphacode_app_core::ironbark_permissions::*;
+use crate::alphacode_tool_core::{ToolContext, ToolExecutionMode};
+use serde_json::json;
+use std::sync::Arc;
+
+fn ctx(root: &std::path::Path, gate: Arc<dyn PermissionGate>) -> ToolContext {
+    ToolContext { session_id: uuid::Uuid::new_v4().to_string(), message_id: "m".into(), tool_call_id: "t".into(), working_dir: Some(root.into()), stdin_request_tx: None, graceful_shutdown_signal: None, execution_mode: ToolExecutionMode::Direct, permission_gate: Some(gate), permission_receipt: None }
+}
+fn gate(root: &std::path::Path) -> (Arc<TransportGate>, tokio::sync::mpsc::UnboundedReceiver<PermissionRequest>) {
+    let (gate, requests) = TransportGate::new(ManagedIdentity { build_digest: "a".repeat(64), effective_route: json!({"connection_id":"owned","model_id":"fixed","harness":"alphacode"}), cwd: root.canonicalize().unwrap().display().to_string(), allowed_tools: vec!["write".into()], profile: "/owned".into(), socket: "/owned/daemon.sock".into() }, std::time::Duration::from_millis(30));
+    gate.bind_state(1, "b".repeat(64)).unwrap(); (gate, requests)
+}
+#[tokio::test]
+async fn ironbark_permission_direct_execution_cannot_skip_gate() {
+    let root = tempfile::tempdir().unwrap(); let file = root.path().join("protected"); std::fs::write(&file, "original").unwrap();
+    let protected_file_before = std::fs::read(&file).unwrap();
+    let (gate, mut requests) = gate(root.path()); let context = ctx(root.path(), gate.clone());
+    let (events, mut observed) = tokio::sync::mpsc::unbounded_channel();
+    gate.bind_events(events).unwrap();
+    let reply = tokio::spawn(async move { let req = requests.recv().await.unwrap(); gate.reply(req.request_id, req.action, false).unwrap(); });
+    assert!(write::WriteTool::new().execute(json!({"file_path":"protected","content":"changed"}), context).await.is_err());
+    reply.await.unwrap(); let protected_file_after = std::fs::read(file).unwrap();
+    assert_eq!(protected_file_after, protected_file_before);
+    assert!(observed.try_recv().is_err(), "Denied concrete tool must not emit native dispatch start");
+}
+#[tokio::test]
+async fn ironbark_permission_child_context_keeps_gate() {
+    let root = tempfile::tempdir().unwrap(); let (gate, _requests) = gate(root.path());
+    let parent = ctx(root.path(), gate); let child = parent.for_subcall("child".into());
+    assert!(Arc::ptr_eq(parent.permission_gate.as_ref().unwrap(), child.permission_gate.as_ref().unwrap()));
+    assert!(child.permission_receipt.is_none());
+    let file = root.path().join("protected"); std::fs::write(&file, "original").unwrap(); let protected_file_before = std::fs::read(&file).unwrap();
+    assert!(write::WriteTool::new().execute(json!({"file_path":"protected","content":"changed"}), child).await.is_err());
+    let protected_file_after = std::fs::read(file).unwrap(); assert_eq!(protected_file_after, protected_file_before);
+}
+#[tokio::test]
+async fn ironbark_permission_missing_reply_or_disconnect_denies() {
+    let root = tempfile::tempdir().unwrap(); let (gate, requests) = gate(root.path()); let context = ctx(root.path(), gate.clone());
+    assert!(context.authorize("write", &json!({})).await.is_err()); drop(requests);
+    assert!(context.authorize("write", &json!({})).await.is_err());
+}
+#[tokio::test]
+async fn ironbark_permission_gate_uses_final_normalised_input() {
+    let root = tempfile::tempdir().unwrap(); let (gate, mut requests) = gate(root.path()); let context = ctx(root.path(), gate.clone());
+    let input = json!("{\"file_path\":\"protected\",\"content\":\"changed\"}");
+    let expected = json!({"file_path":"protected","content":"changed"});
+    let registry = Registry { tools: Arc::new(RwLock::new(HashMap::from([("write".into(), Arc::new(write::WriteTool::new()) as Arc<dyn Tool>)]))), skills: Registry::shared_skills_registry(), compaction: Arc::new(RwLock::new(CompactionManager::new())) };
+    let request = tokio::spawn(async move { let req = requests.recv().await.unwrap(); assert_eq!(req.action.resolved_name, "write"); assert_eq!(req.action.canonical_input, expected); gate.reply(req.request_id, req.action, false).unwrap(); });
+    assert!(registry.execute("write", input, context).await.is_err()); request.await.unwrap();
+}
+#[tokio::test]
+async fn ironbark_permission_registry_denial_precedes_every_sink() {
+    let root = tempfile::tempdir().unwrap(); let file = root.path().join("protected"); std::fs::write(&file,"original").unwrap(); let protected_file_before = std::fs::read(&file).unwrap();
+    let (gate, _requests) = gate(root.path()); let context = ctx(root.path(),gate);
+    let registry = Registry { tools: Arc::new(RwLock::new(HashMap::from([("write".into(), Arc::new(write::WriteTool::new()) as Arc<dyn Tool>)]))), skills: Registry::shared_skills_registry(), compaction: Arc::new(RwLock::new(CompactionManager::new())) };
+    assert!(registry.execute("write", json!({"file_path":"protected","content":"changed"}),context).await.is_err());
+    let protected_file_after = std::fs::read(file).unwrap(); assert_eq!(protected_file_after, protected_file_before);
+}
+#[tokio::test]
+async fn ironbark_permission_receipt_is_exact_and_single_use() {
+    let root = tempfile::tempdir().unwrap(); let (gate, mut requests) = gate(root.path()); let context = ctx(root.path(), gate.clone());
+    let action = gate.action(&context, "write", &json!({"file_path":"protected","content":"changed"})).unwrap();
+    let approval = tokio::spawn(async move { let req = requests.recv().await.unwrap(); gate.reply(req.request_id, req.action, true).unwrap(); });
+    let receipt = context.authorize("write", &action.canonical_input).await.unwrap().unwrap(); approval.await.unwrap();
+    let mut changed = action.clone(); changed.canonical_input["content"] = json!("other");
+    assert!(receipt.consume(&changed).is_err());
+    receipt.consume(&action).unwrap(); assert!(receipt.consume(&action).is_err());
+}
+#[tokio::test]
+async fn ironbark_permission_cancel_drops_pending_before_any_write() {
+    let root = tempfile::tempdir().unwrap(); let file = root.path().join("protected"); std::fs::write(&file, "original").unwrap();
+    let protected_file_before = std::fs::read(&file).unwrap();
+    let (gate, mut requests) = gate(root.path()); let context = ctx(root.path(), gate.clone());
+    let task = tokio::spawn(async move { write::WriteTool::new().execute(json!({"file_path":"protected","content":"changed"}), context).await });
+    let _request = requests.recv().await.unwrap(); task.abort(); assert!(task.await.unwrap_err().is_cancelled());
+    gate.bind_state(2, "c".repeat(64)).unwrap();
+    let protected_file_after = std::fs::read(file).unwrap(); assert_eq!(protected_file_after, protected_file_before);
+}
+#[tokio::test]
+async fn ironbark_permission_actual_allowed_write_emits_exact_native_start() {
+    let root = tempfile::tempdir().unwrap(); let (gate, mut requests) = gate(root.path());
+    let (events, mut observed) = tokio::sync::mpsc::unbounded_channel(); gate.bind_events(events).unwrap();
+    let context = ctx(root.path(), gate.clone());
+    let input = json!({"file_path":"artifact","content":"real native artifact"});
+    let expected = gate.action(&context, "write", &input).unwrap();
+    let approval = tokio::spawn(async move { let request = requests.recv().await.unwrap(); gate.reply(request.request_id, request.action, true).unwrap(); });
+    write::WriteTool::new().execute(input, context).await.unwrap(); approval.await.unwrap();
+    assert_eq!(std::fs::read_to_string(root.path().join("artifact")).unwrap(), "real native artifact");
+    match observed.recv().await.unwrap() { crate::protocol::ServerEvent::IronbarkToolStarted { action } => assert_eq!(action, expected), event => panic!("Unexpected native event {event:?}") }
+}
+#[test]
+#[cfg(target_os = "linux")]
+fn ironbark_permission_shell_child_environment_cannot_inherit_credentials() {
+    let root = tempfile::tempdir().unwrap();
+    let mut command = std::process::Command::new("/usr/bin/env");
+    command.env("OPENAI_API_KEY", "private-provider-sentinel").env("BASH_ENV", "/private/controller-init").env("ALPHACODE_HOME", "/private/controller-profile");
+    set_managed_child_environment(&mut command, root.path().to_str().unwrap());
+    let output = command.output().unwrap(); assert!(output.status.success());
+    let text = String::from_utf8(output.stdout).unwrap();
+    assert!(!text.contains("private-provider-sentinel")); assert!(!text.contains("BASH_ENV")); assert!(!text.contains("ALPHACODE_HOME"));
+    let mut keys: Vec<_> = text.lines().map(|line| line.split_once('=').unwrap().0).collect(); keys.sort();
+    assert_eq!(keys, vec!["HOME", "LANG", "PATH"]);
+    assert!(text.lines().any(|line| line == format!("HOME={}", root.path().display())));
+}
