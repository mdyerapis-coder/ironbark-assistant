diff --git i/src/alphacode_app_core/ironbark_permissions.rs w/src/alphacode_app_core/ironbark_permissions.rs
new file mode 100644
index 0000000..09c2a75
--- /dev/null
+++ w/src/alphacode_app_core/ironbark_permissions.rs
@@ -0,0 +1,157 @@
+//! Mandatory managed dispatch boundary. Authority comes only from the owning host connection.
+use anyhow::{Result, bail};
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{collections::HashMap, sync::{Arc, LazyLock, OnceLock, atomic::{AtomicBool, Ordering}}, time::Duration};
+use parking_lot::Mutex;
+use tokio::sync::{mpsc, oneshot};
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct NativeAction {
+    pub session_id: String, pub tool_call_id: String, pub resolved_name: String,
+    pub canonical_input: Value, pub cwd: String, pub route: Value,
+    pub policy_version: u64, pub state_digest: String,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedIdentity {
+    pub build_digest: String, pub effective_route: Value, pub cwd: String,
+    pub allowed_tools: Vec<String>, pub profile: String, pub socket: String,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PermissionRequest { pub request_id: String, pub action: NativeAction }
+#[derive(Clone)]
+pub struct PermissionReceipt { action: NativeAction, consumed: Arc<AtomicBool> }
+impl PermissionReceipt {
+    pub fn consume(&self, action: &NativeAction) -> Result<()> {
+        if &self.action != action || self.consumed.swap(true, Ordering::SeqCst) { bail!("PermissionReceiptMismatchOrReplay"); }
+        Ok(())
+    }
+}
+#[async_trait]
+pub trait PermissionGate: Send + Sync {
+    fn action(&self, ctx: &crate::alphacode_tool_core::ToolContext, name: &str, input: &Value) -> Result<NativeAction>;
+    async fn check(&self, action: NativeAction) -> Result<PermissionReceipt>;
+    fn started(&self, action: NativeAction) -> Result<()>;
+}
+type Pending = HashMap<String, (NativeAction, oneshot::Sender<bool>)>;
+struct PendingPermission<'a> { pending: &'a Mutex<Pending>, id: &'a str }
+impl Drop for PendingPermission<'_> { fn drop(&mut self) { self.pending.lock().remove(self.id); } }
+pub struct TransportGate {
+    pub identity: ManagedIdentity, tx: mpsc::UnboundedSender<PermissionRequest>,
+    pending: Mutex<Pending>, state: Mutex<Option<(u64, String)>>, timeout: Duration,
+    connected: AtomicBool,
+    events: OnceLock<mpsc::UnboundedSender<crate::protocol::ServerEvent>>,
+}
+impl TransportGate {
+    pub fn new(identity: ManagedIdentity, timeout: Duration) -> (Arc<Self>, mpsc::UnboundedReceiver<PermissionRequest>) {
+        let (tx, rx) = mpsc::unbounded_channel();
+        (Arc::new(Self { identity, tx, pending: Mutex::new(HashMap::new()), state: Mutex::new(None), timeout, connected: AtomicBool::new(true), events: OnceLock::new() }), rx)
+    }
+    pub fn bind_events(&self, tx: mpsc::UnboundedSender<crate::protocol::ServerEvent>) -> Result<()> {
+        self.events.set(tx).map_err(|_| anyhow::anyhow!("PermissionEventsAlreadyBound"))
+    }
+    pub fn bind_state(&self, version: u64, digest: String) -> Result<()> {
+        if digest.len() != 64 || !digest.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)) { bail!("InvalidStateDigest"); }
+        if !self.pending.lock().is_empty() { bail!("PendingPermissionStateChange"); }
+        *self.state.lock() = Some((version, digest)); Ok(())
+    }
+    pub fn reply(&self, id: String, action: NativeAction, allowed: bool) -> Result<()> {
+        let Some((expected, sender)) = self.pending.lock().remove(&id) else { bail!("UnknownPermissionRequest"); };
+        if expected != action { let _ = sender.send(false); bail!("PermissionIdentityMismatch"); }
+        let _ = sender.send(allowed); Ok(())
+    }
+    pub fn disconnect(&self) { self.connected.store(false, Ordering::SeqCst); self.pending.lock().clear(); }
+}
+#[async_trait]
+impl PermissionGate for TransportGate {
+    fn action(&self, ctx: &crate::alphacode_tool_core::ToolContext, name: &str, input: &Value) -> Result<NativeAction> {
+        if !self.connected.load(Ordering::SeqCst) { bail!("PermissionHostDisconnected"); }
+        if !self.identity.allowed_tools.iter().any(|t| t == name) { bail!("ToolNotAllowed"); }
+        let cwd = ctx.working_dir.as_ref().ok_or_else(|| anyhow::anyhow!("MissingManagedCwd"))?.canonicalize()?.display().to_string();
+        if cwd != self.identity.cwd { bail!("ManagedCwdMismatch"); }
+        let (policy_version, state_digest) = self.state.lock().clone().ok_or_else(|| anyhow::anyhow!("MissingHostPolicyState"))?;
+        Ok(NativeAction { session_id: ctx.session_id.clone(), tool_call_id: ctx.tool_call_id.clone(), resolved_name: name.into(), canonical_input: input.clone(), cwd, route: self.identity.effective_route.clone(), policy_version, state_digest })
+    }
+    fn started(&self, action: NativeAction) -> Result<()> {
+        if !self.connected.load(Ordering::SeqCst) { bail!("PermissionHostDisconnected"); }
+        if let Some(events) = self.events.get() {
+            events.send(crate::protocol::ServerEvent::IronbarkToolStarted { action }).map_err(|_| anyhow::anyhow!("NativeEventHostDisconnected"))?;
+        } else if managed() { bail!("MissingManagedEventTransport"); }
+        Ok(())
+    }
+    async fn check(&self, action: NativeAction) -> Result<PermissionReceipt> {
+        if !self.connected.load(Ordering::SeqCst) { bail!("PermissionHostDisconnected"); }
+        let request_id = uuid::Uuid::new_v4().to_string(); let (sender, receiver) = oneshot::channel();
+        self.pending.lock().insert(request_id.clone(), (action.clone(), sender));
+        // Task cancellation drops this guard too, closing the reply receiver.
+        let _pending = PendingPermission { pending: &self.pending, id: &request_id };
+        if self.tx.send(PermissionRequest { request_id: request_id.clone(), action: action.clone() }).is_err() { self.pending.lock().remove(&request_id); bail!("PermissionHostDisconnected"); }
+        let answer = tokio::time::timeout(self.timeout, receiver).await;
+        self.pending.lock().remove(&request_id);
+        if !matches!(answer, Ok(Ok(true))) { bail!("PermissionDeniedOrTimeout"); }
+        if !self.connected.load(Ordering::SeqCst) { bail!("PermissionHostDisconnected"); }
+        Ok(PermissionReceipt { action, consumed: Arc::new(AtomicBool::new(false)) })
+    }
+}
+static IDENTITY: OnceLock<ManagedIdentity> = OnceLock::new();
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ControllerIdentity { pub controller_pid: u32, pub daemon_pid: u32, pub acp_pid: u32 }
+static CONTROLLER: OnceLock<ControllerIdentity> = OnceLock::new();
+pub fn configure_controller(controller: ControllerIdentity) -> Result<()> { CONTROLLER.set(controller).map_err(|_| anyhow::anyhow!("ControllerAlreadyConfigured")) }
+static GATES: LazyLock<Mutex<HashMap<String, Arc<TransportGate>>>> = LazyLock::new(|| Mutex::new(HashMap::new()));
+pub fn managed() -> bool { IDENTITY.get().is_some() }
+pub fn identity() -> Option<&'static ManagedIdentity> { IDENTITY.get() }
+pub fn configure(identity: ManagedIdentity) -> Result<()> { IDENTITY.set(identity).map_err(|_| anyhow::anyhow!("ManagedIdentityAlreadyConfigured")) }
+pub fn session_gate(session: &str) -> Option<Arc<TransportGate>> { GATES.lock().get(session).cloned() }
+pub fn attach(session: String, gate: Arc<TransportGate>) -> Result<()> {
+    let mut gates = GATES.lock();
+    if gates.contains_key(&session) { bail!("ManagedSessionAlreadyOwned"); } gates.insert(session, gate); Ok(())
+}
+pub fn detach(session: &str) { if let Some(gate) = GATES.lock().remove(session) { gate.disconnect(); } }
+pub fn extension(gate_active: bool) -> Result<Value> {
+    let i = identity().ok_or_else(|| anyhow::anyhow!("NotIronbarkManaged"))?;
+    if !gate_active { bail!("PermissionGateInactive"); }
+    Ok(serde_json::json!({"permissionsVersion":1,"gateActive":true,"buildDigest":i.build_digest,"effectiveRoute":i.effective_route,"cwd":i.cwd,"allowedTools":i.allowed_tools,"profile":i.profile,"socket":i.socket}))
+}
+#[derive(Default)]
+pub struct ConnectionOwner { sessions: Vec<String> }
+impl ConnectionOwner {
+    pub fn owns(&self, session: &str) -> bool { self.sessions.iter().any(|s| s == session) }
+    pub fn add(&mut self, session: String) { self.sessions.push(session); }
+}
+impl Drop for ConnectionOwner { fn drop(&mut self) { for session in &self.sessions { detach(session); } } }
+/// Only the C3-owned ACP sibling may own a managed session/reply channel.
+/// Same-user socket permissions do not exclude native shell/tool descendants.
+#[cfg(target_os = "linux")]
+pub fn validate_controller_peer(stream: &crate::alphacode_app_core::transport::Stream) -> Result<()> {
+    let credentials = stream.peer_cred()?;
+    if credentials.uid() != unsafe { libc::geteuid() } { bail!("ManagedPeerUidMismatch"); }
+    let pid = credentials.pid().ok_or_else(|| anyhow::anyhow!("MissingManagedPeerPid"))?;
+    let controller = CONTROLLER.get().ok_or_else(|| anyhow::anyhow!("MissingControllerAttestation"))?;
+    if pid as u32 != controller.acp_pid || std::process::id() != controller.daemon_pid || unsafe { libc::getppid() } as u32 != controller.controller_pid { bail!("ManagedPeerIsNotControllerOwnedAcpSibling"); }
+    Ok(())
+}
+#[cfg(not(target_os = "linux"))]
+pub fn validate_controller_peer(_stream: &crate::alphacode_app_core::transport::Stream) -> Result<()> { bail!("ManagedPeerContainmentRequiresLinux"); }
+#[cfg(target_os = "linux")]
+pub fn validate_daemon_peer(stream: &crate::alphacode_app_core::transport::Stream) -> Result<()> {
+    let credentials = stream.peer_cred()?;
+    let controller = CONTROLLER.get().ok_or_else(|| anyhow::anyhow!("MissingControllerAttestation"))?;
+    if credentials.uid() != unsafe { libc::geteuid() } || credentials.pid().map(|pid| pid as u32) != Some(controller.daemon_pid) || std::process::id() != controller.acp_pid || unsafe { libc::getppid() } as u32 != controller.controller_pid { bail!("ManagedDaemonIsNotControllerOwnedSibling"); }
+    Ok(())
+}
+#[cfg(not(target_os = "linux"))]
+pub fn validate_daemon_peer(_stream: &crate::alphacode_app_core::transport::Stream) -> Result<()> { bail!("ManagedPeerContainmentRequiresLinux"); }
+/// Fixed managed shell environment: controller/provider credentials and shell
+/// startup injection must never flow into arbitrary approved tool descendants.
+pub(crate) fn set_managed_child_environment(command: &mut std::process::Command, cwd: &str) {
+    command.env_clear().env("PATH", "/usr/local/bin:/usr/bin:/bin").env("HOME", cwd).env("LANG", "C.UTF-8");
+}
+pub(crate) fn sanitize_managed_child_command(command: &mut std::process::Command) {
+    if let Some(identity) = identity() { set_managed_child_environment(command, &identity.cwd); }
+}
