index 0000000..945f8b1
--- /dev/null
+++ w/src/cli/ironbark_managed.rs
@@ -0,0 +1,96 @@
+use anyhow::{Result, bail};
+use super::args::{Args, Command};
+use crate::alphacode_app_core::ironbark_permissions::{configure, ManagedIdentity};
+use std::path::Path;
+#[cfg(unix)]
+fn owned(path: &Path, directory: bool) -> Result<()> {
+    use std::os::unix::fs::MetadataExt;
+    let metadata = std::fs::symlink_metadata(path)?;
+    if metadata.file_type().is_symlink() || metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o077 != 0 || metadata.is_dir() != directory { bail!("ManagedPathMustBePrivateOwnedAndNotSymlink"); }
+    Ok(())
+}
+#[cfg(not(unix))]
+fn owned(_path: &Path, _directory: bool) -> Result<()> { bail!("IronbarkManagedRequiresUnixContainment"); }
+pub(super) fn prepare(args: &mut Args) -> Result<()> {
+    read_controller_bootstrap(args)?;
+    if !matches!(args.command, Some(Command::Serve { .. }) | Some(Command::Acp)) { bail!("ManagedModeOnlyDedicatedServeOrAcp"); }
+    let manifest = args.ironbark_identity.as_ref().ok_or_else(|| anyhow::anyhow!("MissingManagedIdentity"))?;
+    owned(manifest, false)?;
+    let identity: ManagedIdentity = serde_json::from_slice(&std::fs::read(manifest)?)?;
+    let digest = option_env!("IRONBARK_ALPHACODE_BUILD_DIGEST").ok_or_else(|| anyhow::anyhow!("UnqualifiedBuildMissingDigest"))?;
+    if digest.len() != 64 || identity.build_digest != digest { bail!("ManagedBuildDigestMismatch"); }
+    let profile = Path::new(&identity.profile); owned(profile, true)?;
+    if profile.canonicalize()? != profile || Path::new(&identity.socket).parent() != Some(profile) { bail!("DedicatedSocketProfileMismatch"); }
+    if std::env::var_os("ALPHACODE_HOME").as_deref() != Some(profile.as_os_str()) { bail!("ManagedProfileEnvironmentMismatch"); }
+    if args.socket.as_deref() != Some(identity.socket.as_str()) || args.provider_profile.as_deref().filter(|s| !s.is_empty()).is_none() { bail!("ExplicitManagedSocketAndProviderProfileRequired"); }
+    if args.provider_profile.as_deref() != identity.effective_route.get("connection_id").and_then(serde_json::Value::as_str) || identity.effective_route.get("harness").and_then(serde_json::Value::as_str) != Some("alphacode") { bail!("ManagedProviderProfileRouteMismatch"); }
+    let model = identity.effective_route.get("model_id").and_then(serde_json::Value::as_str).ok_or_else(|| anyhow::anyhow!("MissingManagedModel"))?;
+    if !managed_model_is_explicit(model) || args.model.as_deref() != Some(model) { bail!("ManagedRouteMustBeExplicit"); }
+    if !matches!(args.provider, super::provider_init::ProviderChoice::OpenaiCompatible) { bail!("ManagedProviderMustBeExplicitNamedProfile"); }
+    let tools: Vec<_> = args.tools.as_deref().ok_or_else(|| anyhow::anyhow!("ExplicitToolAllowlistRequired"))?.split(',').map(str::to_owned).collect();
+    if tools != identity.allowed_tools || tools.iter().any(|t| !["read","write","edit","multiedit","apply_patch","patch","bash","ls","agentgrep","batch","todo"].contains(&t.as_str())) { bail!("ManagedToolAllowlistMismatchOrUnauthorisedTool"); }
+    if args.cwd.as_deref() != Some(identity.cwd.as_str()) || Path::new(&identity.cwd).canonicalize()?.display().to_string() != identity.cwd { bail!("ManagedCwdMismatch"); }
+    args.no_update = true; args.auto_update = false; args.no_selfdev = true; args.disable_base_tools = true;
+    crate::alphacode_core::env::set_var("ALPHACODE_NO_TELEMETRY", "1");
+    configure(identity)
+}
+#[cfg(target_os = "linux")]
+fn read_controller_bootstrap(args: &Args) -> Result<()> {
+    use std::io::Read;
+    use std::os::fd::FromRawFd;
+    use std::os::unix::fs::FileTypeExt;
+    use crate::alphacode_app_core::ironbark_permissions::{ControllerIdentity, configure_controller};
+    // exec resets dumpability: this call is deliberately IN the native entry path,
+    // not just in the C3 launcher's pre_exec hook.
+    if unsafe { libc::prctl(libc::PR_SET_DUMPABLE, 0) } != 0 || unsafe { libc::prctl(libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) } != 0 { bail!("ManagedPostExecProcessHardeningFailed"); }
+    let fd = args.ironbark_controller_fd.filter(|fd| *fd >= 3).ok_or_else(|| anyhow::anyhow!("MissingControllerBootstrapFd"))?;
+    // C3 explicitly transfers ownership of this inherited pipe to us.
+    let mut pipe = unsafe { std::fs::File::from_raw_fd(fd) };
+    if !pipe.metadata()?.file_type().is_fifo() { bail!("ControllerBootstrapMustBePipe"); }
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+    if flags < 0 || unsafe { libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0 || unsafe { libc::fcntl(fd, libc::F_SETFD, libc::FD_CLOEXEC) } < 0 { bail!("ControllerBootstrapFdHardeningFailed"); }
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    let mut bootstrap = Vec::with_capacity(4096);
+    let mut buffer = [0u8; 512];
+    loop {
+        if std::time::Instant::now() >= deadline { bail!("ControllerBootstrapTimeout"); }
+        match pipe.read(&mut buffer) {
+            Ok(0) => break,
+            Ok(n) => {
+                if bootstrap.len() + n > 4096 { bail!("ControllerBootstrapOversize"); }
+                bootstrap.extend_from_slice(&buffer[..n]);
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                let remaining = deadline.saturating_duration_since(std::time::Instant::now()).as_millis().min(5000) as i32;
+                let mut poll = libc::pollfd { fd, events: libc::POLLIN, revents: 0 };
+                let ready = unsafe { libc::poll(&mut poll, 1, remaining) };
+                if ready < 0 && std::io::Error::last_os_error().kind() != std::io::ErrorKind::Interrupted { bail!("ControllerBootstrapPollFailed"); }
+                if ready == 0 { bail!("ControllerBootstrapTimeout"); }
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(error) => return Err(error.into()),
+        }
+    }
+    drop(pipe); // No tool/child inherits controller bootstrap material.
+    let controller: ControllerIdentity = serde_json::from_slice(&bootstrap)?;
+    let own = std::process::id();
+    let own_expected = if matches!(args.command, Some(Command::Acp)) { controller.acp_pid } else { controller.daemon_pid };
+    if own != own_expected || unsafe { libc::getppid() } as u32 != controller.controller_pid || controller.acp_pid == controller.daemon_pid || controller.controller_pid == 0 { bail!("ManagedControllerProcessIdentityMismatch"); }
+    configure_controller(controller)
+}
+#[cfg(not(target_os = "linux"))]
+fn read_controller_bootstrap(_args: &Args) -> Result<()> { bail!("IronbarkManagedRequiresLinux"); }
+fn managed_model_is_explicit(model: &str) -> bool {
+    !model.is_empty() && model == model.trim() && !model.eq_ignore_ascii_case("auto") && !model.ends_with("/auto") && !model.starts_with("kilo-auto/") && !crate::alphacode_provider_metadata::free_pool::is_free_tier_model_id(model)
+}
+#[cfg(test)]
+mod tests {
+    use super::managed_model_is_explicit;
+    #[test]
+    fn ironbark_permission_rejects_native_free_and_automatic_selectors() {
+        for model in ["", "auto", "AUTO", "openrouter/auto", "kilo-auto/free", "kilo-auto/efficient", "kilo-auto/small", "kilo-auto/frontier", "kilo-auto/balanced", "openrouter/free", "fixture:free", " fixed-model "] {
+            assert!(!managed_model_is_explicit(model), "{model} must not select a managed route");
+        }
+        assert!(managed_model_is_explicit("fixed-model"));
+    }
+}
