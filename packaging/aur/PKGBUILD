# Maintainer: Mason <ironbark@llmclouds.au>
# Ironbark Assistant — native workstation assistant core, CLI and namespace bridge.
#
# Builds the Rust workspace from the tagged source archive. The Bun adapter
# workspace (packages/*) is present in the source for operator use and for
# contract type-checking but is not built by this package.
#
# Layout (see docs/runtime/containment.md):
#   /usr/bin/ironbark-core        daemon + namespace runner (host path is free;
#                                 the supervisor bind-mounts it into the worker
#                                 namespace at /opt/ironbark/namespace-runner)
#   /usr/bin/ironbark-cli         operator CLI (one JSON DTO per subcommand)
#   /opt/ironbark/namespace-bridge  network bridge, staged at this EXACT path;
#                                 the containment code requires it there
#
# Desktop integration: an honest headless application entry (the core daemon is
# the installed surface; there is no GUI yet). The emblem icon is original art,
# not derived from the imagery pack (artwork rights disposition pending).

pkgname=ironbark-assistant
pkgver=0.1.0
pkgrel=1
pkgdesc="Standalone workstation assistant: Rust core (SQLite, IPC, policy, containment) with CLI and namespace bridge"
arch=(x86_64)
url="https://github.com/mdyerapis-coder/ironbark-assistant"
license=(MIT)
depends=(glibc bubblewrap)
makedepends=(rust desktop-file-utils gtk-update-icon-cache)
optdepends=(
    "bun: provider/JEV adapter worker runtime"
)
source=(
    "https://github.com/mdyerapis-coder/ironbark-assistant/archive/refs/tags/v${pkgver}.tar.gz"
)
# Self-sourced package: the archive is produced by this repository's own tag,
# so its hash cannot be pinned inside the tag (that would be a regress).
# Pinned on the AUR side once the package is submitted and the tag is frozen.
sha256sums=('SKIP')

build() {
    cd "${srcdir}/ironbark-assistant-${pkgver}"
    cargo build --release -p ironbark-core -p ironbark-cli
}

package() {
    cd "${srcdir}/ironbark-assistant-${pkgver}"
    install -Dm755 target/release/ironbark-core   -t "${pkgdir}/usr/bin"
    install -Dm755 target/release/ironbark-cli    -t "${pkgdir}/usr/bin"
    install -Dm755 target/release/namespace_bridge -t "${pkgdir}/opt/ironbark"
    install -Dm644 LICENSE  -t "${pkgdir}/usr/share/licenses/${pkgname}"
    install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
    install -Dm644 packaging/desktop/ironbark-assistant.desktop -t "${pkgdir}/usr/share/applications"
    install -Dm644 packaging/desktop/ironbark-assistant.svg -t "${pkgdir}/usr/share/icons/hicolor/scalable/apps"
}

post_install() {
    update-desktop-database -q
    gtk-update-icon-cache -q -f -t /usr/share/icons/hicolor 2>/dev/null || true
}

post_upgrade() {
    post_install
}

post_remove() {
    update-desktop-database -q
}
